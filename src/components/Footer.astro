---
import { brand, productNav } from '../data/site';

interface Props {
  variant?: 'nani' | 'bidbox';
}

const { variant = 'nani' } = Astro.props;
const isBidbox = variant === 'bidbox';
const year = new Date().getFullYear();

const links = isBidbox
  ? [
      { label: '서비스', href: productNav[0].href },
      { label: '요금', href: productNav[1].href },
      { label: '회사소개', href: '/company/' },
    ]
  : [
      { label: '회사소개', href: '/company/' },
      { label: '문의', href: '/bidbox/contact/' },
    ];
---

{isBidbox ? (
  <footer class="border-t" style="border-color:var(--bb-border)">
    <div class="wrap flex flex-col items-start justify-between gap-4 py-8 text-[0.8125rem] sm:flex-row sm:items-center" style="color:var(--bb-muted)">
      <p>
        {brand.productFooter} · {brand.footerNote} © {year} {brand.company}. All rights reserved.
      </p>
      <nav aria-label="푸터" class="flex flex-wrap gap-1">
        {links.map((link) => (
          <a href={link.href} class="inline-flex min-h-[44px] items-center px-3 hover:text-[color:var(--bb-text)]">{link.label}</a>
        ))}
      </nav>
    </div>
  </footer>
) : (
  <footer class="border-t" style="border-color:var(--nani-border)">
    <div class="wrap grid gap-6 py-10 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <p class="display text-[1.5rem]">{brand.company}</p>
        <p class="mt-3 text-[0.8125rem]" style="color:var(--nani-muted)">
          © {year} {brand.company}. {brand.footerNote}
        </p>
      </div>
      <nav aria-label="푸터" class="flex flex-wrap gap-1 text-[0.8125rem]" style="color:var(--nani-muted)">
        {links.map((link) => (
          <a href={link.href} class="inline-flex min-h-[44px] items-center px-3 hover:text-[color:var(--nani-ink)]">{link.label}</a>
        ))}
      </nav>
    </div>
  </footer>
)}
