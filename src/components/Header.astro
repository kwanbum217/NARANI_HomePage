---
import Logo from './Logo.astro';
import { siteNav, productNav, primaryCta } from '../data/site';

interface Props {
  variant?: 'nani' | 'bidbox';
  active?: string;
}

const { variant = 'nani', active } = Astro.props;
const isBidbox = variant === 'bidbox';
const items = isBidbox ? productNav : siteNav;
const cta = isBidbox ? primaryCta.program : primaryCta.demo;

const borderToken = isBidbox ? 'var(--bb-border)' : 'var(--nani-border)';
const ctaClass = 'btn btn-primary min-h-[44px]! px-5! py-2! text-sm!';
const rowClass = `wrap flex items-center justify-between gap-6 ${isBidbox ? 'h-[72px]' : 'py-4'}`;
---

<header class="site-nav" x-data="siteNav">
  <div class={rowClass}>
    <Logo variant={variant} />

    {isBidbox && (
      <nav aria-label="주요" class="hidden items-center gap-2 md:flex">
        <ul class="flex items-center gap-1">
          {items.map((item) => (
            <li>
              <a
                class="nav-link"
                href={item.href}
                aria-current={active === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="ml-2 border-l pl-6" style="border-color:var(--bb-border-strong)">
          <a class={ctaClass} href={cta.href}>{cta.label}</a>
        </div>
      </nav>
    )}

    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full border md:hidden"
      style={`border-color:${borderToken}`}
      @click="toggle()"
      :aria-expanded="open.toString()"
      aria-controls="mobile-nav"
      :aria-label="open ? '메뉴 닫기' : '메뉴 열기'"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path
          x-show="!open"
          d="M3 6h14M3 10h14M3 14h14"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path>
        <path
          x-show="open"
          x-cloak
          d="M5 5l10 10M15 5L5 15"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  {!isBidbox && (
    <nav aria-label="주요" class="wrap hidden items-center justify-between gap-6 pb-4 md:flex">
      <ul class="flex items-center gap-1">
        {items.map((item) => (
          <li>
            <a
              class="nav-link"
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class={ctaClass} href={cta.href}>{cta.label}</a>
    </nav>
  )}

  <div
    id="mobile-nav"
    x-show="open"
    x-cloak
    class="border-t md:hidden"
    style={`border-color:${borderToken}`}
  >
    <nav class="wrap py-4" aria-label="모바일">
      <ul class="grid gap-1">
        {items.map((item) => (
          <li>
            <a
              class="nav-link nav-link--block"
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="pt-2">
          <a class="btn btn-primary btn-block" href={cta.href}>{cta.label}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
