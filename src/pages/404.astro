---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="페이지를 찾을 수 없습니다 — NARANI"
  description="요청하신 주소에 해당하는 페이지를 찾을 수 없습니다. 회사소개 홈과 BIDBOX 문의 페이지로 이동하실 수 있습니다."
  variant="nani"
>
  <meta slot="head" name="robots" content="noindex" />
<section class="warm-field">
          <div class="wrap pb-[clamp(56px,9vw,104px)] pt-[clamp(56px,9vw,104px)]">
            <p class="label">404</p>
            <h1 class="display mt-5 max-w-[24ch] text-[clamp(2rem,5vw,3.5rem)]">
              페이지를 찾을 수 없습니다
            </h1>
            <p class="lede mt-6 max-w-[52ch]">
              주소가 바뀌었거나 입력한 주소에 오타가 있을 수 있습니다. 주소를 다시 확인하시고,
              아래에서 이동하실 곳을 선택해 주세요.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a class="btn btn-primary" href="/">홈으로 이동</a>
              <a class="btn btn-ghost" href="/bidbox/contact/">문의하기</a>
            </div>
          </div>
        </section>
</BaseLayout>
