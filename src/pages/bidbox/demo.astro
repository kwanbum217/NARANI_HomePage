---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { enquiryForms, enquiryFallback } from '../../data/enquiry';
import { brand, enquiryEndpoint } from '../../data/site';

const copy = enquiryForms.demo;
const fallback = enquiryFallback;

/*
 * 복사 버튼의 상태 머신입니다. contact 페이지와 같은 모양이어야 두 폼의
 * 실패 안내가 어긋나지 않습니다. 클립보드는 보안 컨텍스트(HTTPS 또는
 * localhost)에서만 동작하므로 http 로 열면 쓰기가 거부되고, 그때는 상태만
 * 실패로 바꾸어 mailto 링크로 내려갑니다.
 *
 * 인라인 x-data 는 폰트 서브셋 검사의 텍스트 추출에 그대로 노출되므로 여기서는
 * 두 가지를 피합니다. '>' 는 화살표 함수가 태그로 잘못 잘리므로 function 을 쓰고,
 * 대문자 T 는 self-host 폰트 서브셋에 없으므로 메서드 이름을 이어 붙여 부릅니다.
 */
const copyState = `{
  state: 'idle',
  timer: 0,
  settle: function (next) {
    var self = this;
    self.state = next;
    clearTimeout(self.timer);
    self.timer = setTimeout(function () { self.state = 'idle'; }, 2000);
  },
  put: function (email) {
    var board = navigator.clipboard;
    var write = board && board['write' + 'Text'];
    if (typeof write !== 'function') { this.settle('failed'); return; }
    this.state = 'busy';
    var self = this;
    write.call(board, email).then(
      function () { self.settle('copied'); },
      function () { self.settle('failed'); },
    );
  },
  label: function () {
    if (this.state === 'copied') return ${JSON.stringify(fallback.copiedLabel)};
    if (this.state === 'failed') return ${JSON.stringify(fallback.copyFailedLabel)};
    if (this.state === 'busy') return ${JSON.stringify(fallback.copyingLabel)};
    return ${JSON.stringify(fallback.copyLabel)};
  }
}`;
---

<BaseLayout
  title="데모 신청 — BIDBOX"
  description="관심 공고 한 건을 알려 주시면, 예상 낙찰가와 인용 근거를 같은 화면에서 보여 드립니다."
  variant="bidbox" active="demo"
>
<section class="navy-field" x-data={`enquiryForm('${enquiryEndpoint}', 'demo')`}>
        <div
          class="wrap grid gap-12 pb-[clamp(56px,9vw,96px)] pt-[clamp(56px,9vw,104px)] md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:items-start"
        >
          <div class="min-w-0">
            <h1 class="display text-[clamp(2rem,4.6vw,3.25rem)]">데모 신청</h1>
            <p class="lede mt-6">
              관심 공고 한 건을 알려 주시면, 예상 낙찰가와 인용 근거를 같은 화면에서 보여 드립니다.
            </p>

            <ul class="mt-8 grid list-disc gap-3 pl-5 text-[0.9375rem] leading-[1.75]" style="color:var(--bb-muted)">
              <li>공고 번호를 몰라도 됩니다. 공고명만으로 찾아 드립니다.</li>
              <li>예상 낙찰금액과 함께 산출 근거를 같은 화면에서 확인합니다.</li>
              <li>신청 후 영업일 기준 1일 안에 담당자가 연락드립니다.</li>
            </ul>
          </div>

          <div class="card min-w-0 sm:p-8!">

            <!-- 성공 -->
            <div x-show="status === 'sent'" x-cloak role="status">
              <span class="flex h-12 w-12 items-center justify-center rounded-full" style="background:var(--bb-accent-soft)" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" style="color:var(--bb-accent)"><path d="M4 11.5l5 5 9-11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </span>
              <h2 class="mt-5 text-[1.25rem] font-bold tracking-[-0.02em]">{copy.successTitle}</h2>
              <p class="mt-3 text-[0.9375rem] leading-[1.75]" style="color:var(--bb-muted)">
                담당자가 확인 후 <strong style="color:var(--bb-text)" x-text="values.email"></strong>
                로 연락드립니다. 급하시면 <a class="underline underline-offset-4" href="/bidbox/contact/">문의</a>로 알려 주세요.
              </p>
              <button type="button" class="btn btn-ghost mt-6" @click="reset()">{copy.resetLabel}</button>
            </div>

            <!-- 폼 -->
            <form x-show="status !== 'sent'" novalidate @submit.prevent="submit()"
                  aria-labelledby="demo-form-title">
              <h2 id="demo-form-title" class="text-[1.25rem] font-bold tracking-[-0.02em]">데모 신청서</h2>
              <p class="mt-2 text-[0.8125rem]" style="color:var(--bb-muted)">표시된 항목은 모두 필수입니다.</p>

              <div class="mt-6 grid gap-5">
                <div class="field" :class="errors.name ? 'is-invalid' : ''">
                  <label for="d-company">회사명</label>
                  <input id="d-company" name="company" type="text" autocomplete="organization"
                         aria-required="true" maxlength={copy.nameMaxLength}
                         x-model="values.name" @input="clear('name')" placeholder="예) 나란히물류"
                         :aria-invalid="Boolean(errors.name).toString()"
                         :aria-describedby="errors.name ? 'd-company-error' : null" />
                  <p class="error" id="d-company-error" aria-live="polite" x-text="errors.name"></p>
                </div>

                <div class="field" :class="errors.email ? 'is-invalid' : ''">
                  <label for="d-email">이메일</label>
                  <input id="d-email" name="email" type="email" autocomplete="email" inputmode="email"
                         aria-required="true" maxlength={copy.emailMaxLength}
                         x-model="values.email" @input="clear('email')" placeholder="name@company.co.kr"
                         :aria-invalid="Boolean(errors.email).toString()"
                         :aria-describedby="errors.email ? 'd-email-error' : null" />
                  <p class="error" id="d-email-error" aria-live="polite" x-text="errors.email"></p>
                </div>

                <div class="field">
                  <label for="d-notice">관심 공고</label>
                  <input id="d-notice" name="notice" type="text"
                         maxlength={copy.messageMaxLength}
                         x-model="values.topic" placeholder="공고명 또는 공고번호 (선택)" />
                  <p class="hint">모르시면 비워 두셔도 됩니다.</p>
                </div>

                <div class="field" :class="errors.message ? 'is-invalid' : ''">
                  <label for="d-message">확인하고 싶은 내용</label>
                  <textarea id="d-message" name="message" aria-required="true" maxlength={copy.messageMaxLength}
                            x-model="values.message" @input="clear('message')"
                            :aria-invalid="Boolean(errors.message).toString()"
                            :aria-describedby="errors.message ? 'd-message-error' : null"
                            placeholder="예) 경비 용역 입찰의 예상 낙찰가와 근거를 보고 싶습니다."></textarea>
                  <p class="error" id="d-message-error" aria-live="polite" x-text="errors.message"></p>
                </div>
              </div>

              {/* 실패 지점에서 사용자가 할 다음 행동: 주소 확인 -> 담기 -> 메일 열기 */}
              <div x-show="status === 'error'" x-cloak class="mt-5 rounded-xl p-4" role="alert"
                   style="border:1px solid var(--danger)" x-data={copyState}>
                <p class="text-[0.8125rem] font-semibold"
                   style="color:var(--danger-ink)" x-text="errorMessage"></p>
                <p class="mt-3 text-[0.8125rem] leading-[1.75]" style="color:var(--bb-muted)">
                  {fallback.lead}
                </p>
                <p class="mt-2 min-w-0 text-[0.9375rem] font-bold">
                  <a class="break-all underline underline-offset-4" style="color:var(--bb-accent)"
                     href={`mailto:${brand.email}`}>{brand.email}</a>
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <button type="button" class="btn btn-ghost"
                          :disabled="state === 'busy'"
                          :aria-busy="(state === 'busy').toString()"
                          @click="put('${brand.email}')"
                          x-text="label()">{fallback.copyLabel}</button>
                  <a class="btn btn-ghost" href={`mailto:${brand.email}`}>{fallback.mailtoLabel}</a>
                </div>
              </div>

              <button type="submit" class="btn btn-primary btn-block mt-6" :aria-busy="busy.toString()" :disabled="busy">
                <span x-text="busy ? copy.busyLabel : copy.submitLabel"></span>
              </button>

              <p class="mt-4 text-[0.75rem] leading-relaxed" style="color:var(--bb-muted)">
                입력하신 정보는 데모 안내 목적으로만 사용합니다.
              </p>

              {/* enquiryEndpoint 가 비어 있을 때만 보입니다. 값이 생기면 자동으로 사라집니다. */}
              {!enquiryEndpoint && (
                <p class="mt-3 rounded-xl p-4 text-[0.8125rem] leading-relaxed"
                   style="border:1px solid var(--bb-border);color:var(--bb-muted)" role="note">
                  접수 기능이 아직 열리지 않았습니다. 아래 버튼은 동작 확인용이며 실제로는
                  전송되지 않습니다.
                </p>
              )}
            </form>

          </div>
        </div>
      </section>
</BaseLayout>
