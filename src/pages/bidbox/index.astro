---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { capabilities } from '../../data/site';
---

<BaseLayout
  title="BIDBOX — 용역분야에 전문화된 입찰서비스"
  description="정보 나열이 아니라, AI로 예상 입찰가까지 제시합니다. 공공조달 입찰 데이터를 읽고 낙찰금액을 예상하는 BIDBOX."
  variant="bidbox" active="bidbox"
>
<section class="navy-field">
        <div class="wrap pb-[clamp(40px,6vw,72px)] pt-[clamp(56px,9vw,104px)]">
          <div class="max-w-[46ch]">
            <p class="label">용역 분야 전문</p>
            <h1 class="display mt-5 text-[clamp(2rem,5.2vw,3.75rem)]">
              용역분야에 전문화된<br />입찰서비스
            </h1>
            <p class="lede mt-6">
              정보 나열이 아니라, AI로 <strong style="color:var(--bb-accent)">예상 입찰가까지</strong> 제시합니다.
              근로자파견 · 경비업 · 위생관리용역업 · 직업소개업에 특화된 데이터로 예측합니다.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a class="btn btn-primary" href="/bidbox/pricing/">프로그램 접속</a>
              <a class="btn btn-ghost" href="/bidbox/demo/">데모 신청</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section-tight" aria-labelledby="specimen">
        <div class="wrap grid gap-10 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:items-start">
          <div class="min-w-0">
            <h2 id="specimen" class="text-[clamp(1.4rem,3vw,2rem)]">예측 결과</h2>
            <p class="label mt-3">예시</p>
            <p class="lede mt-5">
              예측값은 공고 · 낙찰 이력과 시장 동향을 함께 분석한 결과이며, 산출 근거를 같은 화면에서
              확인할 수 있습니다.
            </p>
          </div>

          <div class="min-w-0 overflow-x-auto">
            <table class="data-table">
              <caption class="sr-only">예시 예측 결과</caption>
              <tbody>
                <tr>
                  <th scope="row">공고</th>
                  <td>2026년 시설 경비 용역</td>
                </tr>
                <tr>
                  <th scope="row">구분</th>
                  <td>용역 · 서울</td>
                </tr>
                <tr>
                  <th scope="row">AI 예상 낙찰금액</th>
                  <td class="num text-[clamp(1.25rem,3vw,1.75rem)]" style="color:var(--bb-accent)">
                    ₩418,200,000
                  </td>
                </tr>
                <tr>
                  <th scope="row">기초금액</th>
                  <td class="num">₩452,000,000</td>
                </tr>
                <tr>
                  <th scope="row">예상 낙찰률</th>
                  <td class="num">92.5%</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section-tight" aria-labelledby="highlights">
        <div class="wrap">
          <h2 id="highlights" class="text-[clamp(1.4rem,3vw,2rem)]">BIDBOX가 하는 일</h2>

          <div class="rows mt-8">
            {capabilities.map((capability) => (
              <article class="grid min-w-0 gap-3 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.4fr)] md:items-baseline">
                <h3 class="text-[1.25rem] font-bold tracking-[-0.02em]">{capability.title}</h3>
                <p class="text-[0.9375rem] leading-[1.75]" style="color:var(--bb-muted)">
                  {capability.body}
                </p>
              </article>
            ))}
          </div>

          <a class="mt-8 inline-flex items-center gap-2 font-bold" style="color:var(--bb-accent)" href="/bidbox/service/">
            서비스 자세히 보기
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </section>
</BaseLayout>
