---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { plans, pointRate, POINT_NOTE } from '../../data/pricing';
import { faqs } from '../../data/faq';

const won = (n: number) => '₩' + n.toLocaleString('ko-KR');

// Alpine only drives the order dialog; the plan rows are rendered at build time.
// 다이얼로그 금액도 서버에서 won 으로 미리 만들어 넘기므로 통화 규칙은 5행 한 곳에만 있습니다.
// 문의 폼으로 넘길 주소도 여기서 만듭니다. 브라우저에서 조합하면 인코딩 코드가
// x-data 안에 실려 폰트 서브셋 검사(6단계)의 대상 문자가 되므로 빌드 시점에 끝냅니다.
const contactPage = '/bidbox/contact/';
const dialogPlans = plans.map((plan) => ({
  ...plan,
  priceText: won(plan.price),
  contactHref: `${contactPage}?plan=${encodeURIComponent(plan.label)}`,
}));

/*
 * 다이얼로그 상태 객체는 x-data 로 인라인되어 HTML 에 그대로 실립니다. 그래서
 * 안에 적은 한국어 설명이 폰트 서브셋 검사(6단계)의 대상 문자가 됩니다. 설명이
 * 필요하면 여기(빌드 시 사라지는 자리)에 두고, 상태 객체 안에는 남기지 않습니다.
 *
 * 같은 이유로 상태 객체 안에는 '>' 를 쓰지 않습니다. 폰트 검사는 태그를 지울 때
 * 첫 '>' 까지만 지우는데, x-data 안에 '=>' 가 있으면 태그가 거기서 끊기고
 * 뒤따르는 코드가 화면 문자로 잘못 집계됩니다. 그코드가 라벨 문자열을 흘려보내면
 * 서브셋 밖 글자로 걸립니다. 아래 find 는 그래서 화살표 대신 function 을 씁니다.
 */
const dialogState = `{
  plans: ${JSON.stringify(dialogPlans)},
  selected: null,
  choose(id) {
    this.selected = this.plans.find(function (p) { return p.id === id; }) ?? null;
    if (this.selected) this.$refs.order.showModal();
  },
  closeOrder() { this.$refs.order.close(); },
  goContact() {
    if (this.selected) window.location.href = this.selected.contactHref;
  }
}`;

/*
 * goContact 는 선택한 상품을 문의 폼으로 넘깁니다. contact 페이지가 상품명으로
 * 보여주므로 아이디가 아니라 사람이 읽는 label 을 쿼리에 담습니다.
 *
 * 앵커의 정적 href 는 쿼리 없는 주소로 둡니다. 거기에 plan 쿼리를 얹어 두면
 * 스크립트가 없는 상태에서 링크 검사(scripts/check-links.mjs)가
 * /bidbox/contact/?plan=... 을 깨진 참조로 판정합니다. 정적 href 를 남겨 두는
 * 이유는 Alpine 이 없을 때에도 링크가 동작해야 하기 때문입니다.
 */
---

<BaseLayout
  title="요금 — BIDBOX"
  description={`1포인트 ${won(pointRate)}. 공고·낙찰 탐색 및 AI 예측당 1포인트가 사용됩니다.`}
  variant="bidbox"
  active="pricing"
>
  <section class="navy-field">
    <div
      class="wrap grid gap-10 pb-12 pt-[clamp(56px,9vw,104px)] md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] md:items-end"
    >
      <div class="min-w-0">
        <h1 class="display max-w-[20ch] text-[clamp(2rem,4.6vw,3.25rem)]">
          기업의 입찰 성공을 지원합니다
        </h1>
        <p class="lede mt-6">
          기업이 비용대비 효율을 체감할 수 있는 비용을 제시합니다.
          필요한 만큼만 포인트로 구매하고, 조회한 만큼만 사용합니다.
        </p>
      </div>

      <div class="min-w-0 md:text-right">
        <p class="label">포인트 단가</p>
        <p class="num mt-3 text-[clamp(1.75rem,4vw,2.5rem)] font-bold">
          1포인트 <span style="color:var(--bb-accent)">{won(pointRate)}</span>
        </p>
        <p class="mt-4 text-[0.9375rem] leading-[1.75]" style="color:var(--bb-muted)">
          공고 · 낙찰 탐색 및 AI 예측당 1포인트가 사용됩니다.
        </p>
        <p class="mt-2 text-[0.8125rem] leading-[1.75]" style="color:var(--bb-muted)">
          ※ {POINT_NOTE}
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight" id="plans" aria-labelledby="plans-title" x-data={dialogState}>
    <div class="wrap">
      <h2 id="plans-title" class="text-[clamp(1.4rem,3vw,2rem)]">포인트 구매</h2>

      <ul class="rows mt-8 list-none p-0">
        {plans.map((plan) => (
          <li
            class={`grid min-w-0 gap-4 md:grid-cols-[minmax(0,0.9fr)_minmax(0,0.75fr)_minmax(0,auto)] md:items-center ${plan.featured ? 'rate-bar' : ''}`}
          >
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-3">
                <p class="text-[1.125rem] font-bold tracking-[-0.02em]">{plan.label}</p>
                {plan.listPrice && <span class="tag">10% 할인</span>}
              </div>
              <p class="mt-2 text-[0.8125rem] font-bold" style="color:var(--bb-muted)">
                {plan.note}
              </p>
            </div>

            <p class="num text-[0.875rem]" style="color:var(--bb-muted)">
              1포인트당 {won(plan.price / plan.points)}
            </p>

            <div class="flex min-w-0 flex-col items-start gap-3 md:items-end">
              <div class="text-left md:text-right">
                <p class="num text-[clamp(1.35rem,3vw,1.75rem)] font-bold">{won(plan.price)}</p>
                {plan.listPrice && (
                  <p class="num mt-1 text-[0.875rem] strike">{won(plan.listPrice)} (10% 할인)</p>
                )}
              </div>
              <!-- 게이트 검사(dialog.js)가 featured 플랜 버튼의 탐색 기준. 마크업 정리 시 지우지 않습니다 -->
              <button
                type="button"
                class="btn btn-primary"
                data-plan-id={plan.id}
                @click={`choose('${plan.id}')`}
                aria-label={`${plan.label} 구매하기`}
              >
                {plan.label} 구매
              </button>
            </div>
          </li>
        ))}
      </ul>

      <p class="mt-6 text-[0.8125rem]" style="color:var(--bb-muted)">
        포인트는 조회 시 사용되며, 구매 후 환불 정책은
        <a class="underline underline-offset-4" href="/bidbox/contact/">문의</a>로 안내받을 수 있습니다.
      </p>
    </div>

    <!-- 주문 확인 -->
    <dialog
      x-ref="order"
      aria-labelledby="order-title"
      class="w-[min(480px,92vw)] rounded-2xl border p-0 backdrop:bg-black/70"
      style="background:var(--bb-surface);border-color:var(--bb-border-strong);color:var(--bb-text)"
    >
      <div class="p-6 sm:p-7" x-show="selected">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="label">주문 확인</p>
            <h2
              id="order-title"
              class="mt-2 text-[1.25rem] font-bold tracking-[-0.02em]"
              x-text="selected ? selected.label + ' 구매' : ''"
            ></h2>
          </div>
          <button
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border"
            style="border-color:var(--bb-border)"
            @click="closeOrder()"
            aria-label="주문 확인 닫기"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>

        <dl class="mt-6 grid gap-3 text-sm">
          <div class="flex justify-between gap-4 border-b pb-3" style="border-color:var(--bb-border)">
            <dt style="color:var(--bb-muted)">상품</dt>
            <dd class="num font-bold" x-text="selected ? selected.label : ''"></dd>
          </div>
          <div class="flex justify-between gap-4 border-b pb-3" style="border-color:var(--bb-border)">
            <dt style="color:var(--bb-muted)">사용 범위</dt>
            <dd class="text-right">공고 · 낙찰 탐색 및 AI 예측 1회당 1포인트</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt style="color:var(--bb-muted)">결제 금액</dt>
            <dd
              class="num text-lg font-bold"
              style="color:var(--bb-accent)"
              x-text="selected ? selected.priceText : ''"
            ></dd>
          </div>
        </dl>

        <p
          class="mt-6 rounded-xl p-4 text-[0.8125rem] leading-relaxed"
          style="background:var(--bb-accent-soft);color:var(--bb-muted)"
        >
          결제 모듈 연동 전입니다. 지금은 <strong style="color:var(--bb-text)">문의로 접수</strong>하면
          담당자가 포인트 충전과 서비스 이용을 안내합니다.
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a class="btn btn-primary btn-block" href="/bidbox/contact/" @click.prevent="goContact()">문의로 접수</a>
          <button type="button" class="btn btn-ghost btn-block" @click="closeOrder()">닫기</button>
        </div>
      </div>
    </dialog>
  </section>

  <section class="section-tight" aria-labelledby="faq-title">
    <div class="wrap">
      <p class="label">자주 묻는 질문</p>
      <h2 id="faq-title" class="mt-3 text-[clamp(1.4rem,3vw,2rem)]">요금과 이용 안내</h2>
      <dl class="rows mt-8">
        {faqs.map((faq) => (
          <div class="grid min-w-0 gap-2 py-5 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:gap-8">
            <dt class="font-bold">{faq.question}</dt>
            <dd class="text-[0.9375rem] leading-[1.75]" style="color:var(--bb-muted)">{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
