---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brand, enquiryEndpoint } from '../../data/site';
import { enquiryForms } from '../../data/enquiry';

const copy = enquiryForms.contact;
---

<BaseLayout
  title="문의 — BIDBOX"
  description="AI 기술로 입찰의 미래를 열어드리는 Bidbox입니다. 언제든지 문의해 주세요."
  variant="bidbox" active="contact"
>
<section class="navy-field" x-data={`enquiryForm('${enquiryEndpoint}')`}>
        <div
          class="wrap grid gap-12 pb-[clamp(56px,9vw,96px)] pt-[clamp(56px,9vw,104px)] md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:items-start"
        >
          <div>
            <h1 class="display max-w-[20ch] text-[clamp(2rem,4.6vw,3.25rem)]">
              함께 더 나은 결정을 내리세요
            </h1>
          <p class="lede mt-6 max-w-[60ch]">
            AI 기술로 입찰의 미래를 열어드리는 Bidbox입니다. 빅데이터 기반의 정밀 분석을 통해
            당신의 비즈니스가 더 나은 결과를 달성할 수 있도록 전문적인 상담을 제공합니다.
            언제든지 문의해 주세요.
          </p>

          <div class="rows mt-10 max-w-[720px]">
            <div class="grid min-w-0 gap-3 md:grid-cols-[minmax(0,0.5fr)_minmax(0,1.5fr)] md:items-baseline">
              <p class="label">이메일</p>
              <p class="min-w-0">
                <a class="font-bold break-all underline underline-offset-4" style="color:var(--bb-accent)" href={`mailto:${brand.email}`}>
                  {brand.email}
                </a>
              </p>
            </div>
            <div class="grid min-w-0 gap-3 md:grid-cols-[minmax(0,0.5fr)_minmax(0,1.5fr)] md:items-baseline">
              <p class="label">채팅 상담</p>
              <p class="text-[0.9375rem] leading-[1.75]" style="color:var(--bb-muted)">
                실시간으로 전문가가 상담을 진행합니다. 평일 09:00–18:00에 응답이 가장 빠릅니다.
              </p>
            </div>
          </div>
          </div>

          <div class="card min-w-0 sm:p-8!">

            <!-- 성공 -->
            <div x-show="status === 'sent'" x-cloak role="status">
              <span class="flex h-12 w-12 items-center justify-center rounded-full" style="background:var(--bb-accent-soft)" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" style="color:var(--bb-accent)"><path d="M4 11.5l5 5 9-11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </span>
              <h2 class="mt-5 text-[1.25rem] font-bold tracking-[-0.02em]">{copy.successTitle}</h2>
              <p class="mt-3 text-[0.9375rem] leading-[1.75]" style="color:var(--bb-muted)">
                담당자가 <strong style="color:var(--bb-text)" x-text="values.email"></strong> 로 회신드립니다.
              </p>
              <button type="button" class="btn btn-ghost mt-6" @click="reset()">{copy.resetLabel}</button>
            </div>

            <!-- 폼 -->
            <form x-show="status !== 'sent'" novalidate @submit.prevent="submit()" aria-labelledby="contact-form-title">
              <h2 id="contact-form-title" class="text-[1.25rem] font-bold tracking-[-0.02em]">문의 남기기</h2>
              <p class="mt-2 text-[0.8125rem]" style="color:var(--bb-muted)">표시된 항목은 모두 필수입니다.</p>

              {/*
                요금 다이얼로그에서 넘어온 주문 내용 표시입니다. 쿼리(plan)가 있을
                때만 나타나므로, 직접 문의 폼에 들어온 사람에게는 보이지 않습니다.
                입력이 아니라 읽기 전용 표시라서 필드 개수도 필수 검증 개수(3)도
                늘지 않습니다. 항목 이름(라벨)을 함께 두어 색만으로 구분되지 않게
                합니다(4장).
              */}
              <p class="mt-4 flex flex-wrap items-baseline gap-2 rounded-xl p-4 text-[0.8125rem] leading-relaxed"
                 style="background:var(--bb-accent-soft);color:var(--bb-muted)"
                 x-show="values.topic" x-cloak role="status">
                <span class="label">주문 상품</span>
                <strong class="text-[0.9375rem]" style="color:var(--bb-text)" x-text="values.topic"></strong>
              </p>

              <div class="mt-6 grid gap-5">
                <div class="field" :class="errors.name ? 'is-invalid' : ''">
                  <label for="c-name">성명</label>
                  <input id="c-name" name="name" type="text" autocomplete="name"
                         :aria-invalid="errors.name ? 'true' : 'false'"
                         :aria-describedby="errors.name ? 'c-name-error' : null"
                         x-model="values.name" @input="clear('name')" placeholder="이름을 입력하세요" />
                  <p class="error" id="c-name-error" aria-live="polite" x-text="errors.name"></p>
                </div>

                <div class="field" :class="errors.email ? 'is-invalid' : ''">
                  <label for="c-email">이메일</label>
                  <input id="c-email" name="email" type="email" autocomplete="email" inputmode="email"
                         :aria-invalid="errors.email ? 'true' : 'false'"
                         :aria-describedby="errors.email ? 'c-email-error' : null"
                         x-model="values.email" @input="clear('email')" placeholder="이메일을 입력하세요" />
                  <p class="error" id="c-email-error" aria-live="polite" x-text="errors.email"></p>
                </div>

                <div class="field" :class="errors.message ? 'is-invalid' : ''">
                  <label for="c-message">문의내용</label>
                  <textarea id="c-message" name="message"
                            :aria-invalid="errors.message ? 'true' : 'false'"
                            :aria-describedby="errors.message ? 'c-message-error' : null"
                            x-model="values.message" @input="clear('message')"
                            placeholder="문의내용을 입력하세요"></textarea>
                  <p class="error" id="c-message-error" aria-live="polite" x-text="errors.message"></p>
                </div>
              </div>

              <p x-show="status === 'error'" x-cloak class="mt-5 rounded-xl p-4 text-[0.8125rem] font-semibold"
                 style="border:1px solid var(--danger);color:var(--danger-ink)" role="alert" x-text="errorMessage"></p>

              <button type="submit" class="btn btn-primary btn-block mt-6" :aria-busy="busy.toString()" :disabled="busy">
                <span x-text="busy ? copy.busyLabel : copy.submitLabel"></span>
              </button>

              <p class="mt-4 text-[0.75rem] leading-relaxed" style="color:var(--bb-muted)">
                입력하신 정보는 상담 목적으로만 사용합니다.
              </p>

              {/*
                접수 API 가 아직 없을 때만 보이는 안내입니다. 시뮬레이션 성공 화면을
                보고 실제로 접수되었다고 믿는 일을 막습니다. enquiryEndpoint 에 값이
                생기면 자동으로 사라집니다.
              */}
              {!enquiryEndpoint && (
                <p class="mt-3 rounded-xl p-4 text-[0.8125rem] leading-relaxed"
                   style="border:1px solid var(--bb-border);color:var(--bb-muted)" role="note">
                  접수 기능이 아직 열리지 않았습니다. 아래 버튼은 동작 확인용이며 실제로는
                  전송되지 않습니다. 문의는{' '}
                  <a class="underline underline-offset-4" href={`mailto:${brand.email}`}>{brand.email}</a>
                  로 보내 주세요.
                </p>
              )}
            </form>

          </div>
        </div>
      </section>
</BaseLayout>
