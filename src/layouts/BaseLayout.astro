---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../data/site';

interface Props {
  title: string;
  description: string;
  variant?: 'nani' | 'bidbox';
  active?: string;
}

const { title, description, variant = 'nani', active } = Astro.props;
const isBidbox = variant === 'bidbox';

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(
  existsSync(join(process.cwd(), 'public/og.png')) ? '/og.png' : '/og.svg',
  Astro.site,
).href;

const favicon = isBidbox ? '/favicon-bidbox.svg' : '/favicon-nani.svg';
const logo = new URL('/favicon-nani.svg', Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: brand.company,
      url: Astro.site,
      logo,
      description: '사용자와 소프트웨어는 나란히 일한다.',
    },
    {
      '@type': 'WebSite',
      name: brand.company,
      url: Astro.site,
    },
  ],
};
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.company} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="NARANI. 사용자와 소프트웨어는 나란히 일한다." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="NARANI. 사용자와 소프트웨어는 나란히 일한다." />
    <meta name="theme-color" content={isBidbox ? '#000000' : '#faf9f7'} />
    <link rel="icon" href={favicon} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <slot name="head" />
  </head>
  <body class={isBidbox ? 'reg-dark' : undefined}>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>

    <Header variant={variant} active={active} />

    <main id="main">
      <slot />
    </main>

    <Footer variant={variant} />

    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
